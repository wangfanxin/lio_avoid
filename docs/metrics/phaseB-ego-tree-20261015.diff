+  void EGOReplanFSM::armTour()
+  {
+    // PATCH 0008, START-ALTITUDE GATE: the SAME two flags construct-time planNextWaypoint() would set
+    // (have_target_ + have_new_target_, both inside planNextWaypoint), set at altitude instead of on the
+    // pad.  have_odom_/have_trigger_ are the conditions that held for the constructor to have reached its
+    // last line at all, so the FSM is left in exactly the state it would have been in; triggerCallback()
+    // additionally records the take-off point, and this is the same moment.
+    waypoint_armed_ = true;
+    init_pt_ = odom_pos_;
+    RCLCPP_INFO(node_->get_logger(),
+                "WP-INDEX: sequence armed, starting the tour at z=%.2f m (gate %.2f m, %d waypoints)",
+                odom_pos_.z(), waypoint_start_alt_, waypoint_num_);
+    // PATCH 0012 (cleanup of 0008): THE TARGET FLAGS MUST NOT OUTLIVE A FAILED FIRST PLAN.
+    // 0008 set have_target_/have_new_target_/have_trigger_ FIRST and then called planNextWaypoint, which on
+    // failure returns without setting end_pt_ or GlobalTrajData (default-constructed; filled only by
+    // setGlobalTraj on success) -- the FSM is then armed with a target that does not exist and
+    // getLocalTarget() runs on indeterminate globals.  Arm the flags only when the leg exists.
+    if (!planNextWaypoint(wps_[wp_id_]))
+    {
+      have_target_ = false;
+      have_new_target_ = false;
+      have_trigger_ = false;
+      waypoint_armed_ = false;
+      RCLCPP_ERROR(node_->get_logger(),
+                   "TOUR-STALL: the tour could NOT be armed: the GLOBAL plan to waypoint 0 of %d failed -- the "
+                   "target flags are left CLEAR (an armed FSM with no end_pt_ and no global trajectory is how "
+                   "the tour gets stuck with nothing in the log)", waypoint_num_);
+      return;
+    }
+    have_target_ = true;
+    have_new_target_ = true;
+    have_trigger_ = true;
   }
 
