diff --git a/src/planner/plan_manage/src/ego_replan_fsm.cpp b/src/planner/plan_manage/src/ego_replan_fsm.cpp
index c62fab3..d88aba4 100755
--- a/src/planner/plan_manage/src/ego_replan_fsm.cpp
+++ b/src/planner/plan_manage/src/ego_replan_fsm.cpp
@@ -270,6 +270,28 @@ namespace ego_planner
     Eigen::Vector3d end_wp(msg->pose.position.x, msg->pose.position.y,
                            msg->pose.position.z > 0.0 ? msg->pose.position.z : 1.0);
 
+    // PATCH I (patches/0005-ego-ignore-repeated-waypoint.patch): IGNORE A WAYPOINT ALREADY BEING PURSUED.
+    // MEASURED 2026-10-14 (sortie R1, the circle): the sender repeats the goal at 1 Hz, and every repeat
+    // rebuilt the GLOBAL trajectory and pushed this FSM into REPLAN_TRAJ -- 106 REPLAN_TRAJ->EXEC_TRAJ and
+    // 47 EXEC_TRAJ->REPLAN_TRAJ transitions, 145 committed trajectories at ~1 Hz whose start alternated
+    // between two pipelines, and a vehicle that never followed one plan long enough to move (the truth never
+    // left E <= 4.69 for the whole stall).  Suppressing the repeats is NOT the answer either: MEASURED
+    // (sortie S1) it left 6 committed trajectories and the aircraft stopped dead, because reaching a goal
+    // puts this FSM into WAIT_TARGET by design and only a new goal pulls it out.  So repeats must keep
+    // arriving and must be no-ops while the SAME goal is under pursuit; after an arrival have_target_ is
+    // false and the next repeat re-arms the FSM exactly as before.
+    if (have_target_ && (end_wp - end_pt_).norm() < 0.10)
+    {
+      static long same_goal_count = 0;
+      if ((same_goal_count++ % 50) == 0)
+      {
+        RCLCPP_INFO(node_->get_logger(),
+                    "WAYPOINT-REPEAT: ignoring a goal %.3f m from the one already being pursued (%ld times)",
+                    (end_wp - end_pt_).norm(), same_goal_count);
+      }
+      return;
+    }
+
     planNextWaypoint(end_wp);
   }
 
