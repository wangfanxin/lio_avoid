+/*
+  Truth tap: one ASCII line per model step with the simulator's own state, for
+  external estimators (the LIO) that need a ground truth far finer than
+  SIMSTATE.  Frames are SITL-native: position/velocity NED (origin = the
+  simulator origin, i.e. the EKF origin), quaternion body->NED, gyro and
+  specific force in body FRD.  Port comes from LIO_TRUTH_TAP; unset = no-op.
+*/
+namespace {
+void truth_tap_update(uint8_t instance, uint64_t t_us, const Vector3d &p, const Vector3f &v,
+                      const Matrix3f &dcm, const Vector3f &gyro, const Vector3f &accel_body)
+{
+    static int fd = -1;
+    static bool init_done = false;
+    static struct sockaddr_in addr {};
+    if (!init_done) {
+        init_done = true;
+        const char *env = getenv("LIO_TRUTH_TAP");
+        if (env != nullptr && *env != 0) {
+            const int port = atoi(env);
+            fd = socket(AF_INET, SOCK_DGRAM, 0);
+            if (fd >= 0) {
+                fcntl(fd, F_SETFL, O_NONBLOCK);
+                memset(&addr, 0, sizeof(addr));
+                addr.sin_family = AF_INET;
+                addr.sin_port = htons(uint16_t(port));
+                addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+                ::printf("TruthTap: LIO_TRUTH_TAP=%u, one line per model step (NED/FRD)\n",
+                         unsigned(port));
+            }
+        }
+    }
+    if (fd < 0) {
+        return;
+    }
+    Quaternion q;
+    q.from_rotation_matrix(dcm);
+    char buf[256];
+    const int n = snprintf(buf, sizeof(buf),
+                           "TAP %u %llu %.6f %.6f %.6f %.6f %.6f %.6f "
+                           "%.8f %.8f %.8f %.8f %.6f %.6f %.6f %.5f %.5f %.5f\n",
+                           unsigned(instance), (unsigned long long)t_us,
+                           (double)p.x, (double)p.y, (double)p.z,
+                           (double)v.x, (double)v.y, (double)v.z,
+                           (double)q.q1, (double)q.q2, (double)q.q3, (double)q.q4,
+                           (double)gyro.x, (double)gyro.y, (double)gyro.z,
+                           (double)accel_body.x, (double)accel_body.y, (double)accel_body.z);
+    if (n > 0 && n < (int)sizeof(buf)) {
+        (void)::sendto(fd, buf, size_t(n), 0, (struct sockaddr *)&addr, sizeof(addr));
+    }
+}
+}  // namespace
