@@ -575,14 +592,48 @@ namespace ego_planner
     case REPLAN_TRAJ:
     {
 
+      // PATCH E (patches/0003-ego-replan-escalation.patch) -- the counter lives at CASE scope, not inside
+      // the failure branch, because the success branch resets it (declaring it inside `else` does not
+      // compile: MEASURED 21:03, "error: 'consecutive_replan_failures' was not declared in this scope").
+      static int consecutive_replan_failures = 0;
+
       if (planFromCurrentTraj(1))
       {
+        consecutive_replan_failures = 0;
         changeFSMExecState(EXEC_TRAJ, "FSM");
         publishSwarmTrajs(false);
       }
       else
       {
-        changeFSMExecState(REPLAN_TRAJ, "FSM");
+        // PATCH E (patches/0003-ego-replan-escalation.patch).
+        // UPSTREAM RETRIES THIS STATE FOREVER AND SILENTLY: on failure it just calls
+        // changeFSMExecState(REPLAN_TRAJ, ...) again.  MEASURED 2026-10-14 (sortie F1): ego's own log holds
+        // 5031 consecutive "from REPLAN_TRAJ to REPLAN_TRAJ" lines, and this callback runs every 10 ms
+        // (ego_replan_fsm.cpp:62), so the planner spent 50.3 s failing to produce a trajectory while the
+        // aircraft hovered, the adapter refused the one stale plan ~600 times, and the mission lost its first
+        // stop to the sequencer's 60 s timeout.  Nothing in the log said the planner was stuck.
+        // Now: every 20th consecutive failure is an ERROR, and 1 s of consecutive failures escalates to a
+        // GLOBAL replan, which starts from the ODOMETRY state (planGlobalTraj(odom_pos_, odom_vel_, ...))
+        // instead of from the tail of an expired local spline -- the escape hatch this state never took.
+        // `static` because there is exactly one EGOReplanFSM per node; a member would mean patching the header.
+        consecutive_replan_failures++;
+        if ((consecutive_replan_failures % 20) == 0)
+        {
+          RCLCPP_ERROR(node_->get_logger(),
