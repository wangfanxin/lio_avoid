+                       consecutive_replan_failures, 0.01 * consecutive_replan_failures);
+        }
+        if (consecutive_replan_failures >= 100)
+        {
+          consecutive_replan_failures = 0;
+          RCLCPP_WARN(node_->get_logger(),
+                      "PLANNER-STALL: escalating to a GLOBAL replan (GEN_NEW_TRAJ) after 1 s of local failures");
+          changeFSMExecState(GEN_NEW_TRAJ, "FSM");
+        }
+        else
+        {
+          changeFSMExecState(REPLAN_TRAJ, "FSM");
+        }
       }
 
       break;
@@ -696,6 +747,26 @@ namespace ego_planner
     // double t_cur = (time_now - info->start_time_).toSec();
     double t_cur = (time_now - info->start_time_).seconds();
 
+    // PATCH D (patches/0003-ego-replan-escalation.patch).
+    // EXEC_TRAJ clamps t_cur to the trajectory's duration; THIS function -- the one every REPLAN calls --
+    // did not.  MEASURED 2026-10-14 (sortie F1): the adapter logged the same plan with
+    // "t_cur 1.185 s of dur 1.185 s (start_time 1791981437.203)" from t=16.7 s to t=66.7 s, i.e. it was
+    // offered a trajectory that had finished ~50 s earlier, and with t_cur past the end the start point
+    // below is the END OF AN EXPIRED SPLINE instead of anything near the vehicle.  Clamping cannot invent a
+    // trajectory, but it makes the replan start from the end of the last committed plan -- the honest
+    // "where the plan believes the vehicle is" -- and says so, once per 100 calls, instead of silently.
+    static long replan_from_expired_count = 0;
+    if (t_cur > info->duration_)
+    {
+      if ((replan_from_expired_count++ % 100) == 0)
+      {
+        RCLCPP_WARN(node_->get_logger(),
+                    "PLANNER-STALL: replanning from an EXPIRED trajectory (t_cur %.3f s > duration %.3f s, %ld times)",
+                    t_cur, info->duration_, replan_from_expired_count);
+      }
+      t_cur = info->duration_;
+    }
+
     start_pt_ = info->position_traj_.evaluateDeBoorT(t_cur);
     start_vel_ = info->velocity_traj_.evaluateDeBoorT(t_cur);
     start_acc_ = info->acceleration_traj_.evaluateDeBoorT(t_cur);
