     case GEN_NEW_TRAJ:
     {
 
+      // PATCH F (patches/0003-ego-replan-escalation.patch) -- counter at case scope (see PATCH E).
+      static int consecutive_global_failures = 0;
+
       bool success = planFromGlobalTraj(10); // zx-todo
