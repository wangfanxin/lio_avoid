--- a/src/planner/plan_manage/src/ego_replan_fsm.cpp
+++ b/src/planner/plan_manage/src/ego_replan_fsm.cpp
@@ -1275,6 +1275,28 @@
 
       auto info = &planner_manager_->local_data_;
 
+      // PATCH 0013 (patches/0013-ego-anchor-the-committed-spline.patch): THE COMMIT LINE.  Everything
+      // downstream measures this spline from the outside -- the adapter's own `ego_adapter PLAN-START`
+      // probe, `tools/plan-start-audit.py`, and the consumer's `first point N m from the vehicle` refusal
+      // -- and until now nothing inside ego said where the spline it is about to publish actually starts.
+      // This is emitted at the single moment a trajectory becomes the committed one (this is the only place
+      // the just-optimised spline is published as `bspline`), so it is once per commit and never on a
+      // failure, a retry, or an intermediate trial.  The numbers are the ones the audit tool measures:
+      //   spline(0) = evaluateDeBoorT(0) -- what the consumer's Path starts from;
+      //   cp0       = the first CONTROL POINT -- for a cubic B-spline this is NOT the curve's start
+      //               ((cp0+4cp1+cp2)/6 is), which is exactly the distinction that hid this defect;
+      //   start_pt_ = the state the FSM handed the planner -- 0.000 m iff the FSM's own guarantee held,
+      //               so a non-zero value here says the FSM-side anchor is the thing that broke.
+      {
+        const double d_spline0 = (info->position_traj_.evaluateDeBoorT(0.0) - odom_pos_).norm();
+        const double d_cp0 = (info->position_traj_.getControlPoint().col(0) - odom_pos_).norm();
+        const double d_start = (start_pt_ - odom_pos_).norm();
+        RCLCPP_WARN(node_->get_logger(),
+                    "PLAN-START: committed spline starts %.3f m from the odometry (cp0 %.3f, spline(0) %.3f, "
+                    "start_pt_ %.3f)",
+                    d_spline0, d_cp0, d_spline0, d_start);
+      }
+
       traj_utils::msg::Bspline bspline;
       bspline.order = 3;
       bspline.start_time = info->start_time_;
