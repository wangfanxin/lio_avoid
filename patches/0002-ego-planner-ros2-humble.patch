diff --git a/src/planner/plan_manage/src/ego_replan_fsm.cpp b/src/planner/plan_manage/src/ego_replan_fsm.cpp
index 78d5eee..f9234bd 100755
--- a/src/planner/plan_manage/src/ego_replan_fsm.cpp
+++ b/src/planner/plan_manage/src/ego_replan_fsm.cpp
@@ -209,11 +209,17 @@ namespace ego_planner
         changeFSMExecState(GEN_NEW_TRAJ, "TRIG");
       else
       {
-        while (exec_state_ != EXEC_TRAJ)
-        {
-          rclcpp::spin_some(node_);
-          std::this_thread::sleep_for(std::chrono::milliseconds(1));
-        }
+        // PATCH B/3 (patches/0002-ego-planner-ros2-humble.patch).
+        // Upstream busy-waits here with
+        //     while (exec_state_ != EXEC_TRAJ) { rclcpp::spin_some(node_); sleep(1 ms); }
+        // which has two independent defects:
+        //   (a) rclcpp::spin_some(node_) adds a node that rclcpp::spin() in main() already owns to a
+        //       SECOND executor, which throws "Node '/ego_planner_node' has already been added to an
+        //       executor" and ABORTS the process.  Observed 2026-10-14: the node died ~1 s into the
+        //       run, on the second goal message.
+        //   (b) the wait could not have terminated on a single-threaded executor in any case: the
+        //       10 ms FSM timer that performs the EXEC_TRAJ transition runs on this very thread.
+        // Setting the state is what the wait was for; the normal FSM loop takes it from here.
         changeFSMExecState(REPLAN_TRAJ, "TRIG");
       }
 
@@ -237,11 +243,32 @@ namespace ego_planner
     if (msg->pose.position.z < -0.1)
       return;
 
+    // PATCH C/3 (patches/0002-ego-planner-ros2-humble.patch).
+    // A waypoint that arrives before the first odometry drives the FSM from INIT straight to
+    // REPLAN_TRAJ, whose planFromCurrentTraj() evaluates `local_data_.position_traj_` -- a B-spline
+    // that has never been built, i.e. an empty control_points_ -- and SEGFAULTS.
+    // MEASURED 2026-10-14: the node died with "Segmentation fault" after logging "no odom." for 7 s,
+    // the moment the first goal arrived.  The goal is DROPPED rather than queued because every
+    // sender repeats it: planner/ego_adapter.py forwards /goal_pose at 1 Hz and does not forward the
+    // first one until it has seen odometry itself.
+    if (!have_odom_)
+    {
+      RCLCPP_WARN(node_->get_logger(),
+                  "waypoint ignored: no odometry yet (REPLAN_TRAJ with no trajectory segfaults)");
+      return;
+    }
+
     cout << "Triggered!" << endl;
 
     init_pt_ = odom_pos_;
 
-    Eigen::Vector3d end_wp(msg->pose.position.x, msg->pose.position.y, 1.0);
+    // PATCH A/3 (patches/0002-ego-planner-ros2-humble.patch).
+    // Upstream DISCARDS the goal's altitude here and hard-codes z = 1.0 m, so a goal commanded at
+    // 2.0 m is planned to 1.0 m.  MEASURED 2026-10-14 with the unpatched node: the published path
+    // ended at W U = +1.1615 m for a goal commanded at U = +2.000 m.  A message with z <= 0 keeps
+    // the old 1.0 m default, so PRESET_TARGET behaviour is unchanged.
+    Eigen::Vector3d end_wp(msg->pose.position.x, msg->pose.position.y,
+                           msg->pose.position.z > 0.0 ? msg->pose.position.z : 1.0);
 
     planNextWaypoint(end_wp);
   }
